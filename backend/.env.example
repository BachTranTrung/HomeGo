# =============================================
# HOMEGO - CẤU HÌNH MÔI TRƯỜNG
# Copy file này thành .env và điền giá trị
# =============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB (MongoDB Atlas hoặc local)
# Local:  mongodb://localhost:27017/homego_db
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/homego_db
MONGODB_URI=mongodb://localhost:27017/homego_db

# JWT
JWT_SECRET=homego_jwt_secret_key_2025_change_this_in_production
JWT_EXPIRES_IN=7d

# Google OAuth (đăng nhập Google)
# Tạo tại: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Dialogflow (Chatbot AI)
# Tạo tại: https://dialogflow.cloud.google.com
DIALOGFLOW_PROJECT_ID=your_dialogflow_project_id
DIALOGFLOW_CREDENTIALS_PATH=./src/config/dialogflow-credentials.json

# VNPay (Thanh toán)
# Đăng ký tại: https://sandbox.vnpayment.vn/devreg/
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/payment/vnpay-return

# Google Maps (Frontend dùng trực tiếp)
# Tạo tại: https://console.cloud.google.com → Maps JavaScript API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# URL Frontend (CORS)
FRONTEND_URL=http://localhost:5500
